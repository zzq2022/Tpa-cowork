# Maintainer: shiwenwen <shiwenwendevelopment@gmail.com>

pkgname=tpa-cowork-bin
pkgver=__PKGVER__
pkgrel=1
pkgdesc='Local-first AI assistant desktop app — cross-device sessions, IM channel routing'
arch=('x86_64' 'aarch64')
url='https://github.com/zzq2022/Tpa-cowork'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator')
provides=('tpa-cowork')
conflicts=('tpa-cowork')
options=('!strip' '!debug')

source_x86_64=("tpa-cowork-${pkgver}-x86_64.deb::${url}/releases/download/v${pkgver}/TPA.CoWork_${pkgver}_amd64.deb")
sha256sums_x86_64=('__SHA256_X86_64__')

source_aarch64=("tpa-cowork-${pkgver}-aarch64.deb::${url}/releases/download/v${pkgver}/TPA.CoWork_${pkgver}_arm64.deb")
sha256sums_aarch64=('__SHA256_AARCH64__')

package() {
    # `bsdtar` (libarchive) handles `ar`-style .deb archives directly.
    # Source filename is per-arch; resolve it via $CARCH (Arch's host arch).
    bsdtar -xf "${srcdir}/tpa-cowork-${pkgver}-${CARCH}.deb" -C "${srcdir}"
    bsdtar -xf "${srcdir}/data.tar.gz" -C "${pkgdir}"
}
